{
  "version": 2,
  "buildCommand": "npm install && cd server && npm install && npm run build --prefix ..",
  "outputDirectory": "build",
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "src": "/(.*)", "dest": "/api/index.js" }
  ]
}
